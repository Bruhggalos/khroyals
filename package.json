{
  "name": "khroyals-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests scripts plugins modules --max-warnings=0",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/send-push/index.ts supabase/functions/send-email/index.ts supabase/functions/import-newsletter/index.ts supabase/functions/student-login/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "import-site": "python3 scripts/import_site.py content/site",
    "regen-comms": "python3 scripts/gen_comms.py mock-db/comms"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "~19.2",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
